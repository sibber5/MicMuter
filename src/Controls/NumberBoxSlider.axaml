<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:c="using:MicMuter.Controls"
             x:Class="MicMuter.Controls.NumberBoxSlider"
             x:Name="Root">

    <UserControl.Resources>
        <c:LenientDoubleConverter x:Key="LenientDoubleConverter"/>
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <Slider Grid.Column="0" Padding="0,-10" VerticalAlignment="Center"
                x:Name="ValueSlider"
                Minimum="{Binding #Root.Minimum, Mode=OneWay}"
                Maximum="{Binding #Root.Maximum, Mode=OneWay}"
                Value="{Binding #Root.Value, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" x:Name="ValueTextBox"
                 Margin="10,0,0,0" VerticalAlignment="Center"
                 Width="43" MinWidth="43" Padding="0" VerticalContentAlignment="Center"
                 TextAlignment="Center"
                 Text="{Binding #Root.Value, Mode=TwoWay, Converter={StaticResource LenientDoubleConverter}}"/>
    </Grid>

</UserControl>
